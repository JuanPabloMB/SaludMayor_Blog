# Configuracion de la aplicacion
APP_NAME=SaludMayor Blog
APP_VERSION=1.0.0
DEBUG=false

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=saludmayor_app
DB_PASSWORD=
DB_NAME=saludmayor_blog

# Seguridad
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Configuracion para Flutter Web
CORS_ORIGINS=["http://localhost:8080"]

# Limites de imagenes en bytes
MAX_POST_IMAGE_SIZE=5242880
MAX_PROFILE_IMAGE_SIZE=2097152
MAX_LOGO_IMAGE_SIZE=2097152

# Proteccion HTTP (ajustar hosts en despliegue)
ALLOWED_HOSTS=["localhost","127.0.0.1","10.0.2.2","testserver"]
AUTH_REQUESTS_PER_MINUTE=20
COOKIE_SECURE=false
